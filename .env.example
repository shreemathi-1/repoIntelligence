# Copy to .env and fill in. Never commit .env.

# --- Server ---
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# --- Database (MongoDB Atlas M0) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/repointelligence

# --- GitHub OAuth App ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/auth/github/callback

# --- Sessions and encryption (generate random 32+ byte values) ---
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=

# --- Redis (Upstash) ---
REDIS_URL=

# --- Analysis worker ---
WORKER_URL=http://localhost:8000
WORKER_SHARED_SECRET=

# --- LLM providers (server-side only) ---
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# --- Email (optional) ---
RESEND_API_KEY=

# --- Discovery ---
# Optional read-only token (no scopes) so anonymous browsing gets the higher rate limit.
GITHUB_TOKEN=
# Set to true to run the daily trending job inside the API process.
TRENDING_JOB_ENABLED=false
